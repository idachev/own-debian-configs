#!/usr/bin/env python3
"""
Display Off - Lock the session and power off the display.

Engages the desktop's own screen locker, then powers the panel down via
DPMS. Useful for leaving the laptop open and running with the screen dark.

Any key press or mouse movement wakes the panel to the locker's password
prompt; the session stays locked until you authenticate, and the locker's
own idle timeout blanks it again afterwards.

Why DPMS here (an earlier revision of this script used `xrandr --off`):
the locker owns the keyboard and mouse once it engages, so this script
can no longer watch for input itself. DPMS is the right mechanism for
that split - the X server wakes the panel on input and the locker
handles the authentication. `xrandr --off` would leave the panel dark
with no way to see the password prompt.
"""

import shutil
import subprocess
import sys
import time

# Screen lockers in preference order: the desktop-native one first, then
# the common cross-desktop daemons. `xflock4` is last as a catch-all -
# note it does not know about cinnamon-screensaver, which is why the
# Cinnamon entry has to come first rather than relying on it.
LOCKERS = (
    ('cinnamon-screensaver-command', ('--lock',)),
    ('xfce4-screensaver-command', ('--lock',)),
    ('mate-screensaver-command', ('--lock',)),
    ('gnome-screensaver-command', ('--lock',)),
    ('xscreensaver-command', ('-lock',)),
    ('light-locker-command', ('--lock',)),
    ('xsecurelock', ()),
    ('i3lock', ('-n',)),
    ('xflock4', ()),
)

# How long to wait for the locker to actually cover the screen before
# powering the panel down. Blanking too early can race with the locker
# mapping its window, which wakes the panel straight back up.
LOCK_SETTLE_TIMEOUT = 5.0
LOCK_POLL_INTERVAL = 0.2
LOCK_SETTLE_GRACE = 0.4


def find_locker():
    for binary, args in LOCKERS:
        path = shutil.which(binary)
        if path:
            return binary, path, args
    print(
        "Error: no supported screen locker found. Tried: "
        + ", ".join(name for name, _ in LOCKERS),
        file=sys.stderr,
    )
    sys.exit(1)


def lock_is_active(binary):
    """True if the locker reports an active screensaver.

    Returns None when the locker has no query interface, so the caller
    can fall back to a plain settle delay instead of polling forever.
    """
    if not binary.endswith('-screensaver-command'):
        return None
    flag = '-time' if binary == 'xscreensaver-command' else '--query'
    try:
        result = subprocess.run(
            [binary, flag], capture_output=True, text=True, timeout=2
        )
    except (subprocess.SubprocessError, OSError):
        return None
    return 'active' in result.stdout.lower() and 'inactive' not in result.stdout.lower()


def wait_for_lock(binary):
    deadline = time.monotonic() + LOCK_SETTLE_TIMEOUT
    while time.monotonic() < deadline:
        state = lock_is_active(binary)
        if state is None:
            break
        if state:
            break
        time.sleep(LOCK_POLL_INTERVAL)
    # Small grace period either way: even once the locker reports active,
    # its window may still be painting.
    time.sleep(LOCK_SETTLE_GRACE)


def run(*args):
    try:
        subprocess.run(args, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError, OSError) as e:
        print(f"Error: '{' '.join(args)}' failed: {e}", file=sys.stderr)
        return False


def main():
    binary, path, lock_args = find_locker()

    if not run(path, *lock_args):
        sys.exit(1)

    wait_for_lock(binary)

    # `dpms force off` is silently a no-op unless DPMS support is enabled.
    if not run('xset', '+dpms'):
        sys.exit(1)
    if not run('xset', 'dpms', 'force', 'off'):
        sys.exit(1)


if __name__ == '__main__':
    main()
