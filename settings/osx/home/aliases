# AWS Profiles

aspl() {
    [ -r "${AWS_CONFIG_FILE:-$HOME/.aws/config}" ] || return 1

    grep '\[profile' "${AWS_CONFIG_FILE:-$HOME/.aws/config}" | \
      sed -e 's/.*profile \([a-zA-Z0-9_\.-]*\).*/\1/'
}

asp() {
    if [ -z "$1" ]; then
        unset AWS_DEFAULT_PROFILE AWS_PROFILE AWS_EB_PROFILE
        echo "AWS profile cleared."
        return
    fi

    local _asp_found=0
    local _asp_p
    for _asp_p in $(aspl); do
      if [ "$_asp_p" = "$1" ]; then
        _asp_found=1
        break
      fi
    done
    if [ "$_asp_found" -eq 0 ]; then
        echo "Profile '$1' not found in '${AWS_CONFIG_FILE:-$HOME/.aws/config}'" >&2
        echo "Available profiles: $(aspl | tr '\n' ' ')" >&2
        return 1
    fi

    export AWS_DEFAULT_PROFILE=$1
    export AWS_PROFILE=$1
    export AWS_EB_PROFILE=$1
}

