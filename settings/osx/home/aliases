# Docker

dkrp() {
  docker ps -a $*
}

dkrn() {
  docker ps --format "{{.Names}}" $*
}

dkrr() {
  docker ps
}

dkrl() {
  docker logs -f $*
}

dkre() {
  docker exec -it $*
}

dkrb() {
  docker exec -it $1 sh -c "clear; (bash || ash || sh)"
}

dkrm() {
  for i in $*; do
    docker stop $i; docker rm $i
  done
}

dkrmold() {
  local ids
  ids=$(docker ps --filter "status=exited" --filter "status=created" --format "{{.ID}}")
  if [ -n "$ids" ]; then
    echo "$ids" | xargs docker rm
  fi
  docker ps --all
}

dkrmi() {
  local ids
  ids=$(docker images --format "{{.ID}}" --filter=reference="${1}")
  if [ -n "$ids" ]; then
    echo "$ids" | xargs docker rmi -f
  fi
  docker images | sort -k7 -h
}

dkrmicl() {
  local ids
  ids=$(docker images --format "{{.ID}}" --filter "dangling=true" -q --no-trunc)
  if [ -n "$ids" ]; then
    echo "$ids" | xargs docker rmi -f
  fi
}

