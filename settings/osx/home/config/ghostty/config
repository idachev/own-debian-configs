# Official Ghostty/XDG config (~/.config/ghostty/config)
# Scale is 0.0–1.0; 1 is fully opaque.
background-opacity = 1
background-blur = false

font-size = 14

# theme = Ultra Dark
# theme = Kitty Default
# theme = Molokai
theme = linux-dark

# Physical Ctrl+letter → ASCII C0 controls. Needed on Cyrillic layouts.
# key_* is the US-position key. BG phonetic: C→Ц D→Д Z→З L→Л R→Р.
# I/J/M/O omitted: those C0 codes alias Tab/LF/CR/SI.
# Docs: https://ghostty.org/docs/config/keybind/reference
keybind = ctrl+key_a=text:\x01
keybind = ctrl+key_b=text:\x02
keybind = ctrl+key_c=text:\x03
keybind = ctrl+key_d=text:\x04
keybind = ctrl+key_e=text:\x05
keybind = ctrl+key_f=text:\x06
keybind = ctrl+key_g=text:\x07
keybind = ctrl+key_h=text:\x08
keybind = ctrl+key_k=text:\x0b
keybind = ctrl+key_l=text:\x0c
keybind = ctrl+key_n=text:\x0e
keybind = ctrl+key_p=text:\x10
keybind = ctrl+key_q=text:\x11
keybind = ctrl+key_r=text:\x12
keybind = ctrl+key_s=text:\x13
keybind = ctrl+key_t=text:\x14
keybind = ctrl+key_u=text:\x15
keybind = ctrl+key_v=text:\x16
keybind = ctrl+key_w=text:\x17
keybind = ctrl+key_x=text:\x18
keybind = ctrl+key_y=text:\x19
keybind = ctrl+key_z=text:\x1a

# Split zoom and cycle. Ghostty actions, not Supacode Settings.
keybind = ctrl+shift+key_x=toggle_split_zoom
keybind = ctrl+shift+tab=goto_split:next

# Grok TUI newline. Shift+Enter sends the same ESC+CR as Option+Enter.
keybind = shift+enter=text:\x1b\r
