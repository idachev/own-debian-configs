###########################################################
# History — set before Oh My Zsh so it does not use ~/.zsh_history

HISTFILE=~/.histfile
HISTSIZE=9999999
SAVEHIST=9999999

###########################################################
# Ghostty / Supacode shell integration
# Auto-injection only covers the shell Ghostty starts; this
# also loads it for exec zsh, tmux, and nested shells.

if [ -n "${GHOSTTY_RESOURCES_DIR}" ]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi

###########################################################
# Oh My Zsh

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# Custom plugins live in this repo (git). Do not symlink over ~/.oh-my-zsh/custom:
# omz update needs that directory as a real git tree.
_omz_custom_from_zshrc="${${(%):-%x}:A:h}/oh-my-zsh/custom"
if [ -d "$_omz_custom_from_zshrc" ]; then
  export ZSH_CUSTOM="$_omz_custom_from_zshrc"
fi
unset _omz_custom_from_zshrc

export NVM_DIR="$HOME/.nvm"
export NVM_HOMEBREW="/opt/homebrew/opt/nvm"
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes
zstyle ':omz:plugins:nvm' silent-autoload yes

plugins=(
  git
  gh
  nvm
  docker
  docker-compose
  kubectl
  helm
  terraform
  aws
  fzf
  z
  extract
  sudo
  macos
  colored-man-pages
  history-substring-search
  copypath
  copyfile
  you-should-use
  zsh-bat
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if command -v fd > /dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
else
  export FZF_DEFAULT_COMMAND="find . -type f ! -path '*/.git/*'"
fi
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='--layout reverse --inline-info'
export FZF_COMPLETION_OPTS='--border --info=inline'
export FZF_COMPLETION_PATH_OPTS='--walker file,dir,follow,hidden'
export FZF_COMPLETION_DIR_OPTS='--walker dir,follow'

[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

###########################################################
# Prompt — after OMZ so robbyrussell is not used

[ -f ~/.zshprompt ] && . ~/.zshprompt

###########################################################
# Options OMZ does not set

unsetopt beep
setopt ignoreeof
setopt noclobber
setopt nobanghist
setopt nohup
setopt extendedglob
setopt pushdsilent
setopt pushdtohome

stty -ixon

export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8

###########################################################
# Mac file handlers (OMZ does not set these)

export EDITOR="vim"
export BROWSER="open"
export VIDEO_PLAYER="open"
export AUDIO_PLAYER="open"
export IMAGE_VIEW="open"
export OFFICE_VIEW="open"
export PDF_VIEW="open"
export ARCHIVE_VIEW="open"
export LOG_VIEW="open"
export FONT_VIEW="open"

alias -s html=$BROWSER
alias -s org=$BROWSER
alias -s php=$BROWSER
alias -s com=$BROWSER
alias -s net=$BROWSER

alias -s PNG=$IMAGE_VIEW
alias -s png=$IMAGE_VIEW
alias -s JPG=$IMAGE_VIEW
alias -s jpg=$IMAGE_VIEW
alias -s jpeg=$IMAGE_VIEW
alias -s GIF=$IMAGE_VIEW
alias -s gif=$IMAGE_VIEW
alias -s WEBP=$IMAGE_VIEW
alias -s webp=$IMAGE_VIEW

alias -s sxw=$OFFICE_VIEW
alias -s doc=$OFFICE_VIEW
alias -s docx=$OFFICE_VIEW
alias -s ods=$OFFICE_VIEW
alias -s xls=$OFFICE_VIEW
alias -s xlsx=$OFFICE_VIEW

alias -s tgz=$ARCHIVE_VIEW
alias -s gz=$ARCHIVE_VIEW
alias -s bz2=$ARCHIVE_VIEW
alias -s zip=$ARCHIVE_VIEW

alias -s java=$EDITOR
alias -s txt=$EDITOR
alias -s PKGBUILD=$EDITOR
alias -s pdf=$PDF_VIEW

alias -s mov=$VIDEO_PLAYER
alias -s mk4=$VIDEO_PLAYER
alias -s mp4=$VIDEO_PLAYER
alias -s mkv=$VIDEO_PLAYER
alias -s m4v=$VIDEO_PLAYER
alias -s mpg=$VIDEO_PLAYER
alias -s mvi=$VIDEO_PLAYER
alias -s avi=$VIDEO_PLAYER
alias -s 3gp=$VIDEO_PLAYER
alias -s 3GP=$VIDEO_PLAYER

alias -s mp3=$AUDIO_PLAYER
alias -s ogg=$AUDIO_PLAYER

alias -s log=$LOG_VIEW
alias -s ttf=$FONT_VIEW

alias -g L='|less'
alias -g S='&> /dev/null &'

###########################################################
# Optional local plugins

if [ -f "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh_codex/zsh_codex.plugin.zsh" ]; then
  source "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh_codex/zsh_codex.plugin.zsh"
  bindkey '^G' create_completion
fi

###########################################################
# Misc

[ -f ~/.aliases ] && . ~/.aliases
[ -f ~/.shell_set_colors ] && . ~/.shell_set_colors
[ -f ~/.ls_dir_set_colors ] && . ~/.ls_dir_set_colors
[ -f ~/.localrc ] && . ~/.localrc

###########################################################
# SSH keys

_mac_ssh_key=""
[ -f ~/.local_ssh_key ] && _mac_ssh_key=~/.local_ssh_key
[ -z "$_mac_ssh_key" ] && [ -f ~/.ssh/id_rsa ] && _mac_ssh_key=~/.ssh/id_rsa

if [ -n "$_mac_ssh_key" ]; then
  if command -v keychain > /dev/null 2>&1; then
    keychain -q "$_mac_ssh_key"
    [ -f ~/.keychain/${HOST}-sh ] && . ~/.keychain/${HOST}-sh
    [ -f ~/.keychain/${HOST}-sh-gpg ] && . ~/.keychain/${HOST}-sh-gpg
  else
    /usr/bin/ssh-add --apple-use-keychain "$_mac_ssh_key" 2>/dev/null
  fi
fi
unset _mac_ssh_key

###########################################################
# Toolchains (guarded; skip if missing)

[ -f ~/bin/aws-vault ] && eval "$(aws-vault --completion-script-zsh)"

if command -v temporal > /dev/null 2>&1; then
  source <(temporal completion zsh)
fi

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv > /dev/null 2>&1 && eval "$(pyenv init - zsh)"

if [ -x ~/.rbenv/bin/rbenv ]; then
  eval "$(~/.rbenv/bin/rbenv init - --no-rehash zsh)"
elif command -v rbenv > /dev/null 2>&1; then
  eval "$(rbenv init - --no-rehash zsh)"
fi

[ -s "$HOME/.bun/_bun" ] && . "$HOME/.bun/_bun"

export PNPM_HOME="${HOME}/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

export FLYCTL_INSTALL="${HOME}/.fly"
export PATH="$FLYCTL_INSTALL/bin:$PATH"

export PATH=${HOME}/.opencode/bin:$PATH

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="${HOME}/.sdkman"
[[ -s "${HOME}/.sdkman/bin/sdkman-init.sh" ]] && source "${HOME}/.sdkman/bin/sdkman-init.sh"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
